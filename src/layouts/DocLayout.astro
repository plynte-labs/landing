---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  pubDate: Date;
  eyebrow: string;
  backHref: string;
  backLabel: string;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, title, description, pubDate, eyebrow, backHref, backLabel, alternates } = Astro.props;
const dateLabel = pubDate.toLocaleDateString(locale === 'es' ? 'es-MX' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const dateIso = pubDate.toISOString().slice(0, 10);
---

<BaseLayout locale={locale} title={title} description={description} alternates={alternates}>
  <article class="doc section">
    <div class="container doc__inner">
      <a class="doc__back" href={backHref}>
        <span aria-hidden="true">←</span>
        {backLabel}
      </a>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="doc__title">{title}</h1>
      <p class="doc__meta">
        <time datetime={dateIso}>{dateLabel}</time>
      </p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .doc__inner {
    max-width: 48rem;
  }
  .doc__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
  }
  .doc__back:hover {
    color: var(--brand-text);
  }
  .doc__title {
    font-size: var(--fs-3xl);
    margin-block: var(--space-3) var(--space-3);
  }
  .doc__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-10);
  }

  .prose :global(h2) {
    font-size: var(--fs-xl);
    margin-block: var(--space-10) var(--space-4);
  }
  .prose :global(h3) {
    font-size: var(--fs-lg);
    margin-block: var(--space-8) var(--space-3);
  }
  .prose :global(p) {
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--space-5);
  }
  .prose :global(ul),
  .prose :global(ol) {
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
  }
  .prose :global(a) {
    color: var(--brand-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: var(--radius-xs);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
  }
  .prose :global(pre) {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }
</style>
