---
import { Image } from "astro:assets";
import type { Locale } from "@/i18n/ui";
import type { ProjectEntry } from "@/features/projects/types";
import { getProjectPath } from "@/features/projects/lib/project-path";

interface Props {
  project: ProjectEntry;
  locale: Locale;
  variant?: "default" | "related";
}

const { project, locale, variant = "default" } = Astro.props;
const copy = project.data.copy[locale];
const isLive = project.data.status === "live";
const statusLabel = isLive
  ? locale === "es"
    ? "Activo"
    : "Live"
  : locale === "es"
    ? "Próximamente"
    : "Coming soon";
const detailLabel = locale === "es" ? "Explorar proyecto" : "Explore project";
const techLabel = locale === "es" ? "Tecnologías" : "Tech stack";
---

<li
  class:list={{
    "project-card-item": true,
    "is-featured": project.data.featured && variant === "default",
    "is-related": variant === "related",
  }}
  data-reveal
>
  <a class="project-card" href={getProjectPath(project.id, locale)}>
    {
      project.data.media[0] && (
        <div class="project-card__media">
          <Image
            src={project.data.media[0].src}
            width={project.data.media[0].width}
            height={project.data.media[0].height}
            alt={project.data.media[0].alt[locale]}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
    <div class="project-card__status">
      <span
        class:list={["project-card__dot", isLive ? "is-live" : "is-soon"]}
        aria-hidden="true"></span>
      <span>{statusLabel}</span>
    </div>

    <h3 class="project-card__name">{copy.name ?? project.data.name}</h3>
    <p class="project-card__description measure">{copy.desc}</p>

    <ul class="project-card__tech" aria-label={techLabel}>
      {project.data.tech.map((technology) => <li>{technology}</li>)}
    </ul>

    <span class="project-card__action">
      {detailLabel}
      <span aria-hidden="true">→</span>
    </span>
  </a>
</li>

<style>
  .project-card-item {
    min-width: 0;
    height: 100%;
  }

  .project-card-item.is-featured {
    grid-column: 1 / -1;
  }

  .project-card {
    box-sizing: border-box;
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--elev-1), var(--ring-inset);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .project-card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card::after {
    content: "";
    position: absolute;
    right: -4rem;
    bottom: -5rem;
    width: 13rem;
    aspect-ratio: 1;
    border: 1px solid var(--border-accent);
    border-radius: 50%;
    opacity: 0.35;
    pointer-events: none;
  }

  .project-card-item.is-featured .project-card {
    border-color: var(--border-accent);
    box-shadow: var(--elev-1), var(--glow-brand);
  }

  .project-card:hover,
  .project-card:focus-visible {
    transform: var(--lift);
    border-color: var(--border-accent);
    box-shadow: var(--elev-2), var(--ring-inset);
  }

  .project-card__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .project-card__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
  }

  .project-card__dot.is-live {
    background: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent);
  }

  .project-card__dot.is-soon {
    background: transparent;
    border: 1.5px solid var(--warning);
  }

  .project-card__name {
    font-size: var(--fs-xl);
  }

  .project-card__description {
    color: var(--text-secondary);
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-card__tech li {
    padding: var(--space-1) var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .project-card__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: auto;
    color: var(--brand-text);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }

  .project-card__action span {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .project-card:hover .project-card__action span,
  .project-card:focus-visible .project-card__action span {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .project-card-item.is-featured {
      grid-column: auto;
    }

    .project-card {
      padding: var(--space-4);
    }
  }
</style>
