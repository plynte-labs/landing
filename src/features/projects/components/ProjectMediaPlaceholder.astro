---
import type { Locale } from '@/i18n/ui';

interface Props {
  projectName: string;
  locale: Locale;
}

const { projectName, locale } = Astro.props;
const initials = projectName
  .split(/\s+/)
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const label = locale === 'es' ? 'Vista previa del proyecto' : 'Project preview';
const pending = locale === 'es' ? 'Recursos visuales pendientes de integración' : 'Visual assets pending integration';
---

<div class="media-placeholder" role="note" aria-label={`${label}: ${projectName}`}>
  <span class="media-placeholder__grid" aria-hidden="true"></span>
  <span class="media-placeholder__index" aria-hidden="true">MEDIA / 00</span>
  <strong class="media-placeholder__mark" aria-hidden="true">{initials}</strong>
  <div class="media-placeholder__caption">
    <span>{label}</span>
    <span>{pending}</span>
  </div>
</div>

<style>
  .media-placeholder {
    position: relative;
    display: grid;
    min-height: clamp(20rem, 52vw, 40rem);
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 25% 20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 34%),
      linear-gradient(145deg, var(--surface-raised), var(--bg-deep));
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-lg);
    box-shadow: var(--elev-3), var(--ring-inset);
  }

  .media-placeholder__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, #000, transparent 88%);
  }

  .media-placeholder__index {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-label);
  }

  .media-placeholder__mark {
    position: relative;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 15rem);
    line-height: 1;
    letter-spacing: -0.08em;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--brand) 55%, transparent);
    text-shadow: 0 0 46px color-mix(in srgb, var(--brand) 18%, transparent);
  }

  .media-placeholder__caption {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    left: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
</style>
