---
import { getCollection, render } from 'astro:content';
import DocLayout from '@/layouts/DocLayout.astro';
import { localizePath, contentAlternates } from '@/i18n/utils';

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const docs = (await getCollection('docs')).filter(
    (d) => d.data.locale === 'en' && (!isProd || !d.data.draft)
  );
  return docs.map((entry) => ({
    params: { slug: entry.id.replace(/^en\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = 'en';
const slug = entry.id.replace(/^en\//, '');
const isProd = import.meta.env.PROD;
const siblingExists = (await getCollection('docs')).some(
  (d) => d.data.locale === 'es' && d.id.replace(/^es\//, '') === slug && (!isProd || !d.data.draft)
);
const alternates = contentAlternates({ collection: 'docs', slug, locale, siblingExists });
---

<DocLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  eyebrow="Documentation"
  backHref={localizePath('/docs', locale)}
  backLabel="Documentation"
  alternates={alternates}
>
  <Content />
</DocLayout>
