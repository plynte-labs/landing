---
import { getCollection } from 'astro:content';
import type { Locale } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import ProjectCard from '@/features/projects/components/ProjectCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const eyebrow = locale === 'es' ? '01 / Ecosistema' : '01 / Ecosystem';
---

<section id="ecosystem" class="section" aria-labelledby="ecosystem-heading">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="ecosystem-heading" class="section__heading">{t('ecosystem.heading')}</h2>

    <ul class="ecosystem__grid">
      {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
    </ul>
  </div>
</section>

<style>
  .section__heading {
    margin-top: var(--space-3);
    margin-bottom: var(--space-10);
    font-size: var(--fs-2xl);
  }

  .ecosystem__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .ecosystem__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
