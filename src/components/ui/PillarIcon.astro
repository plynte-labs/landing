---
// Monochrome line icons for the architecture pillars + mission license mark.
// currentColor + stroke, matching the navbar/theme-toggle icon language.
// Replaces full-color emoji for a consistent, platform-stable, professional look.
interface Props {
  name: string;
}
const { name } = Astro.props;
const common = {
  width: 24,
  height: 24,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.75,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

{
  name === 'local-first' && (
    <svg {...common}>
      <rect x="3" y="4" width="18" height="12" rx="1.5" />
      <path d="M8 20h8M12 16v4" />
    </svg>
  )
}
{
  name === 'mit-license' && (
    <svg {...common}>
      <path d="M13 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8z" />
      <path d="M13 3v5h5" />
      <path d="M9 13h6M9 17h4" />
    </svg>
  )
}
{
  name === 'ci-cd' && (
    <svg {...common}>
      <path d="M3.5 12a8.5 8.5 0 0 1 14.5-6L20 8" />
      <path d="M20 3.5V8h-4.5" />
      <path d="M20.5 12a8.5 8.5 0 0 1-14.5 6L4 16" />
      <path d="M4 20.5V16h4.5" />
    </svg>
  )
}
{
  name === 'hardware-acceleration' && (
    <svg {...common}>
      <path d="M13 2 4 14h7l-1 8 9-12h-7z" />
    </svg>
  )
}
