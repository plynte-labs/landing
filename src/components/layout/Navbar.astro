---
import type { Locale } from '@/i18n/ui';
import { useTranslations, localizePath } from '@/i18n/utils';
import { NAV_ITEMS } from '@/components/layout/navbar.config';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const homeBase = localizePath('/', locale);

const navLabel = locale === 'es' ? 'Navegación principal' : 'Main navigation';
const menuLabel = locale === 'es' ? 'Abrir menú' : 'Open menu';
const toLight = locale === 'es' ? 'Cambiar a tema claro' : 'Switch to light theme';
const toDark = locale === 'es' ? 'Cambiar a tema oscuro' : 'Switch to dark theme';
---

<header class="navbar glass" id="navbar">
  <nav class="container navbar__inner" aria-label={navLabel}>
    <a class="navbar__logo" href={homeBase} aria-label="Plynte Labs">
      <img src="/Plynte.svg" alt="" width="32" height="32" />
      <span class="navbar__wordmark">Plynte<span class="navbar__wordmark-dim">Labs</span></span>
    </a>

    <button
      class="navbar__toggle"
      id="navbar-toggle"
      aria-expanded="false"
      aria-controls="navbar-menu"
      aria-label={menuLabel}
    >
      <span class="navbar__bars" aria-hidden="true"></span>
    </button>

    <div class="navbar__menu" id="navbar-menu">
      <ul class="navbar__links">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a class="navbar__link" href={`${homeBase}${item.hash}`}>
                {t(item.translationKey)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="navbar__controls">
        <LanguageSwitcher locale={locale} />
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label={toLight}
          data-to-light={toLight}
          data-to-dark={toDark}
        >
          <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border-subtle);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .navbar.is-scrolled {
    border-bottom-color: var(--border-accent);
    box-shadow: var(--elev-2);
  }
  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
  }
  .navbar__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-lg);
    letter-spacing: var(--ls-heading);
    color: var(--text);
  }
  .navbar__wordmark-dim {
    color: var(--text-muted);
    font-weight: var(--fw-medium);
    margin-left: 0.15em;
  }
  .navbar__menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .navbar__link {
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    padding-block: var(--space-2);
    transition: color var(--dur-base) var(--ease-out);
  }
  .navbar__link:hover {
    color: var(--text);
  }
  .navbar__controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .navbar__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    cursor: pointer;
  }
  .navbar__bars,
  .navbar__bars::before,
  .navbar__bars::after {
    content: '';
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }
  .navbar__bars::before {
    transform: translateY(-6px);
  }
  .navbar__bars::after {
    transform: translateY(4px);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-accent);
  }
  .theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle .icon-sun {
    display: block;
  }
  :global([data-theme='light']) .theme-toggle .icon-moon {
    display: none;
  }

  @media (max-width: 768px) {
    .navbar__toggle {
      display: inline-flex;
    }
    .navbar__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding: var(--space-6) var(--section-px);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--elev-3);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition:
        transform var(--dur-base) var(--ease-out),
        opacity var(--dur-base) var(--ease-out),
        visibility var(--dur-base);
    }
    .navbar__menu.is-open {
      transform: none;
      opacity: 1;
      visibility: visible;
    }
    .navbar__links {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .navbar__link {
      font-size: var(--fs-md);
    }
    .navbar__controls {
      justify-content: flex-start;
    }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('navbar-toggle');
  const menu = document.getElementById('navbar-menu');
  const themeBtn = document.getElementById('theme-toggle');

  // Scroll elevation, rAF-throttled.
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      navbar?.classList.toggle('is-scrolled', window.scrollY > 50);
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle.
  function setOpen(open: boolean) {
    menu?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  }
  toggle?.addEventListener('click', () => {
    setOpen(!menu?.classList.contains('is-open'));
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Theme toggle — vanilla, persists to localStorage, syncs aria-label.
  function syncThemeLabel() {
    if (!themeBtn) return;
    const isDark = document.documentElement.dataset.theme !== 'light';
    const label = isDark ? themeBtn.dataset.toLight : themeBtn.dataset.toDark;
    if (label) themeBtn.setAttribute('aria-label', label);
  }
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('plynte_theme', next);
    } catch {
      /* storage unavailable */
    }
    syncThemeLabel();
  });
  syncThemeLabel();
</script>
